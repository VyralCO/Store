# ============================================================
# VYRAL — Variáveis de ambiente
# Copie para .env.local e preencha com suas credenciais.
# NUNCA comite .env.local (já está no .gitignore).
# ============================================================

# --- Supabase ---
# Encontre em: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SOMENTE server-side. Nunca exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (Checkout Pro) — usado em tarefas futuras ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
